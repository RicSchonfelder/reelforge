[Unit]
Description=Reelforge — estúdio de Reels
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Unit NÃO-templated: %i expande para vazio e o systemd cai no root.
# Ajuste o usuário e o caminho da sua instalação abaixo.
User=reelforge
Group=reelforge
WorkingDirectory=/opt/reelforge
ExecStart=/usr/bin/node src/dashboard-server.mjs
Restart=on-failure
RestartSec=5
Environment=DASHBOARD_HOST=0.0.0.0
EnvironmentFile=/opt/reelforge/.env

[Install]
WantedBy=multi-user.target
