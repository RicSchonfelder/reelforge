# Nunca envie este arquivo preenchido para o Git.
IG_USER_ID=
IG_ACCESS_TOKEN=

# Mantenha configurável porque a Meta desativa versões antigas periodicamente.
META_API_VERSION=v25.0

# Opcional: caminho completo do ffprobe para validação técnica detalhada.
# Por padrão o Reelforge usa o ffprobe-static que acompanha o npm ci.
FFPROBE_PATH=

# Intervalo do agendador (em segundos, mínimo 5).
SCHEDULER_INTERVAL_SECONDS=15

# Fila automática: aprovação escolhe o próximo horário livre.
AUTO_SCHEDULE_ENABLED=true
DAILY_POST_LIMIT=4
POSTING_TIME_ZONE=America/Sao_Paulo
POSTING_SLOTS=08:00,12:30,18:30,21:00

# Opcional: caminho do executável oficial cloudflared.
# Sem valor, procura bin/cloudflared (Linux/macOS) ou bin/cloudflared.exe (Windows).
# Linux: instale com scripts/install-cloudflared.sh ou via apt/brew.
CLOUDFLARED_PATH=

# Transcrição local (transformers.js/ONNX).
# Padrão: Xenova/whisper-base (leve, q8). Para mais precisão use
# onnx-community/whisper-large-v3-turbo (baixa ~1 GB na primeira execução).
REELFORGE_TRANSCRIBER_MODEL=Xenova/whisper-base
REELFORGE_TRANSCRIBER_DTYPE=q8

# Painel
DASHBOARD_PORT=4170
# IMPORTANTE: mantenha 127.0.0.1 em desktop. Em servidor, use 0.0.0.0 e defina
# REELFORGE_TOKEN para exigir token em todas as mutações via API.
DASHBOARD_HOST=127.0.0.1
# Token opcional de API (quando o painel fica exposto na rede).
REELFORGE_TOKEN=
# Diretório de dados isolado (Docker/backup/testes). Padrão: ./data
REELFORGE_DATA_DIR=
